<h3 style="position:absolute;">
    <span onclick="location.href='<%=section.url%>';" style="cursor:pointer;" >
      <i class="fa fa-arrow-left fa-lg" aria-hidden="true"></i>
      &nbsp;
      <%= section.title %>
    </span>
  </h3>
  
  <style>
    .swiperGallery {
      width: 100%;
      min-height: 400px;
    }
  
    /* #Lightbox {
      vertical-align:middle;
      position:fixed;
      } */
    
    </style>
  
  <section style="margin-top:4rem;">
    <!-- <div class="container px-4 px-lg-5"> -->
        <div class="row gx-4 gx-lg-5 align-items-center">
            <div class="col-md-6 gsapBox" style="text-align: center;margin-bottom:4rem;">
              <div class="swiperGallery">
                <!-- Additional required wrapper -->
                <div class="swiper-wrapper">
                  <% element.images.forEach(function(image, index){%>
                      <a href="upload/<%=image%>" data-lightbox="slider" class="swiper-slide">
                        <img style="margin-bottom: 5px;max-width:100%;max-height:100%;top: 50%;position: relative;transform: translateY(-50%);" src="upload/<%=image%>" />
                      </a>
                  <%});%>
                  <% if(element.images.length>1){ %>
                    <!-- If we need pagination -->
                    <div style="bottom:-10px !important;" class="swiper-pagination"></div>
              
                    <!-- If we need navigation buttons -->
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                  <%}%>
                </div>
                
              </div>
            </div>
            <div class="col-md-6 gsapBox" style="margin-bottom:4rem;">
                <h1 class="display-5 fw-bolder"><%=element.title%></h1>
                <div class="small mb-1">SKU: <%= element._id %> </div>
                <div class="fs-5 mb-5">
                    <span><%=element.price%> €</span>
                    <!-- <span class="text-decoration-line-through"><%=1.5*element.price %> €</span> -->
                </div>
                <p class="lead"><%=element.legend%></p>
                <!-- Si la boutique est ouverte -->
                <% if(general.eCommerce == true){ %>
                    <div class="d-flex">
                        <input disabled class="form-control text-center me-3" id="inputQuantity" type="num" value="1" style="max-width: 3rem" />
                        <% if(element.nbCopy > 0){ %>
                            <% if(currentUser && currentUser.cart.items.some(function(cartItem){ return cartItem.element._id.equals(element._id); })) { %>
                                        <a href="/cart" style="color:white !important;background:rgba(0,0,0,0.8);" class="button-link">Dans le panier</a>
                            <% } else { %>
                                        <a class="button-link" href="/cart/new/<%= element._id %>/<%= element.section.url %>/element">Ajouter au panier</a>
                            <% } %>
                        <% } else { %>
                            <span class="button-link" style="color:white !important;background:rgba(0,0,0,0.8);">Out of stock</a>
                        <% } %>
                    </div>
                    <div class="small mb-1 py-3">En stock: <%=element.nbCopy%></div>
                <% } else { %>
                    <p>La boutique est fermé, revenez plus tard</p>
                <% } %>
            </div>
            <% if(element.description){ %>
                <div class="col-md-12">
                    <h3>Description</h3>
                    <hr>
                    <p id="description" class="lead"></p>
                </div>
            <% } %>
            
        </div>
        
        <!--------------------------- Y O U T U B E     L I N K S --------------------------------->
        <%if(element.youtube.length !=0){%>
          <div class="element-details-box" style="margin-top: 100px;">
            <h3>Vidéos</h3>
            <hr>
            <div class="row">
              <%for(i=0; i<element.youtube.length; i++){ %>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                  <div class="gallery-alan" style="color: #333 !important; text-decoration: none; cursor: pointer;">
                    <figure class="img-container">
                      <div onclick="OpenModal('<%=element.youtube[i]%>');" class="blurYoutube"></div>
                      <iframe width="100%" height="250px"
                        src="https://www.youtube.com/embed/<%=element.youtube[i]%>?controls=0" title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen></iframe>
                    </figure>
                  </div>
                </div>
                <%}%>
            </div>
          </div>
          <%}%>
  </section>
  
  
  
  
  <h1 class="display-3 centered py-5">Autres articles</h1>
  
  <div class="py-5 row gx-4 gx-lg-4 row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4">
    <% showcaseElements.forEach(function(element, index){ %>
        <div style="max-width:50%;cursor:pointer;" onclick="location.href='<%=section.url%>/<%=element.url%>';" alt="Redirection" class="col mb-5">
            <div class="h-100 element-box-hover">
                <img class="element-shop-img" src="upload/<%=element.images[0]%>" />
                <div class="card-body p-4">
                    <div class="text-center">
                        <!-- Product name-->
                        <h3 class="fw-bolder"><%=element.title%></h3>
                        <!-- Product reviews-->
                        <!-- <div class="d-flex justify-content-center small text-warning mb-2">
                            <div class="bi-star-fill"></div>
                            <div class="bi-star-fill"></div>
                            <div class="bi-star-fill"></div>
                            <div class="bi-star-fill"></div>
                            <div class="bi-star-fill"></div>
                        </div> -->
                        <!-- Product price-->
                        <span><%=element.price%> €</span>
                        <!-- <span class="text-muted text-decoration-line-through"><%=1.5*element.price %> €</span> -->
                    </div>
                </div>
                
            </div>
        </div>
    <%})%>
  </div>
  
  <script type="text/javascript">
    const swiper1 = new Swiper(".swiperGallery", {
          spaceBetween: 30,
          effect: "fade",
          speed: 1000,
          fadeEffect: { crossFade: true },
          loop: true,
          autoplay: {
          delay: 5000,
          disableOnInteraction: false,
          },
          navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
          },
          pagination: {
            el: ".swiper-pagination",
            clickable: true,
          },
        });
  
    // alert(window.innerHeight);
    var size = window.innerHeight - 300;
    $(".swiperGallery").css({height: size});
    // $("#lightbox").css({top: "300px"});
  </script>

