<%- include('../partials/header') %>
<%- include('../partials/menu', {menu: menu, general: general}) %>

<%if(general.backgroundImage){%>
  <style media="screen">
      .content {
      background: url('/upload/<%=general.backgroundImage%>') no-repeat center center fixed !important;
      -webkit-background-size: cover !important;
      -moz-background-size: cover !important;
      -o-background-size: cover !important;
      background-size: cover !important;
      /* backdrop-filter: brightness(40%) !important; */
      min-height: 100vh !important;
      color:white  !important;
      /* backdrop-filter: blur(10px) !important; */
      }
      .police-menu{
      color:white !important;
      }
  </style>
<%}%>


<style>

  .text-navy {
      color: #1ab394;
  }
  .cart-product-imitation {
    text-align: center;
    padding-top: 15px;
    height: 80px;
    width: 80px;
  }
  .product-imitation.xl {
    padding: 120px 0;
  }
  .product-desc {
    padding: 20px;
    position: relative;
  }
  .ecommerce .tag-list {
    padding: 0;
  }
  .ecommerce .fa-star {
    color: #d1dade;
  }
  .ecommerce .fa-star.active {
    color: #f8ac59;
  }
  .ecommerce .note-editor {
    border: 1px solid #e7eaec;
  }
  table.shoping-cart-table {
    margin-bottom: 0;
  }
  table.shoping-cart-table tr td {
    border: none;
    text-align: right;
  }
  table.shoping-cart-table tr td.desc,
  table.shoping-cart-table tr td:first-child {
    text-align: left;
  }
  table.shoping-cart-table tr td:last-child {
    width: 80px;
  }
  .ibox {
    clear: both;
    margin-bottom: 25px;
    margin-top: 0;
    padding: 0;
    background: rgba(255,255,255,0.3);
      border: 1px solid lightgray;
  }
  .ibox.collapsed .ibox-content {
    display: none;
  }
  .ibox:after,
  .ibox:before {
    display: table;
  }
  .ibox-title {
    margin-bottom: 0;
    padding: 14px 15px 7px;
    min-height: 48px;
  }
  .ibox-content {
    color: inherit;
    padding: 15px 20px 20px 20px;
    border-color: #e7eaec;
    border-image: none;
    border-style: solid solid none;
    border-width: 1px 0;
  }
  .ibox-footer {
    color: inherit;
    border-top: 1px solid #e7eaec;
    font-size: 90%;
    padding: 10px 15px;
  }
  </style>
  
  <!-- -------------------------------------------- P R O F I L E -------------------------- -->
  <div class="container gsapBox">
      <h1 class="display-3 centered">Mon profil</h1>
  
  <div class="container gsapBox">
      <div class="row">
          <div class="col-md-12 justify-content-centered">
              <div class="ibox">
                  <div class="ibox-content">
                    <form action="/profile" method="POST">
                      	<div class="row my-md-2">
							<div class="col my-1 my-md-0">
								<div class="form-floating">
									<input type="text" class="form-control" value="<%= currentUser.firstName %>" placeholder="First Name" name="firstName" required>
									<label for="floatingInput">Prénom</label>
								</div>
								<!-- <input type="text" name="name" placeholder="Nom Complet" class="form-control" required> -->
							</div>
							<div class="col my-1 my-md-0">
								<div class="form-floating">
									<input type="text" class="form-control" value="<%= currentUser.lastName %>" placeholder="Last Name" name="lastName" required>
									<label for="floatingInput">Nom</label>
								</div>
								<!-- <input type="number" name="contactNo" placeholder="Telephone" class="form-control" required> -->
							</div>
						</div>
					  	<div class="row my-md-2">
							<div class="col my-1 my-md-0">
								<div class="form-floating">
									<input readonly required type="email" class="form-control" value="<%= currentUser.username %>" placeholder="name@example.com" name="email">
									<label for="floatingInput">email</label>
								</div>
								<!-- <input type="text" name="name" placeholder="Nom Complet" class="form-control" required> -->
							</div>
              
							<div class="col my-1 my-md-0">
								<div class="form-floating">
									<input type="number" class="form-control" value="<%= currentUser.phone %>" placeholder="Telephone" name="phone">
									<label for="floatingInput"><%= lang.phone %></label>
								</div>
								<!-- <input type="number" name="contactNo" placeholder="Telephone" class="form-control" required> -->
							</div>
						</div>
            <div class="form-floating">
              <input type="text" class="form-control" value="<%= currentUser.pseudo %>" placeholder="Pseudo" name="pseudo" required>
              <label for="floatingInput">Pseudo</label>
            </div>
                      
                      <div class="d-flex justify-content-center" style="margin:30px 0;">
                        <div id="buttonText"><button onclick="Loading();" class="button-link"  type="submit">Mettre à jour</button></div>
                        <div id="buttonLoading" style="display:none;">Loading...</div>
                      </div>
                    </form>
                  	</div>
              	</div>
         	</div>
		</div>

<br><br>
<!-- -------------------------------------------- C O M M A N D E S-------------------------- -->

<% if(general.eCommerce){%>
	<h1 class="display-3 centered">Mes commandes</h1>

	<div class="container">
		<% if(orders.length != 0){%>
			<div class="row">
				<% orders.forEach(function(order){%>
					<div class="col-md-6 justify-content-centered">
						<div class="ibox">
							<div class="ibox-title">
								<h3>Commande <%=order._id%> </h3>
							</div>
							<div class="ibox-content">
								<p><%=order.firstName%> <%=order.lastName%></p>
								<p><%=order.address.address%>, <%=order.address.zipCode%></p>
								<p><%=order.address.city%>, <%=order.address.country%></p>
								<p><%=order.address.phone%></p>
							</div>
							<div class="ibox-content">
                <p id="showProduct-<%=order._id%>" onclick="$('#<%=order._id%>').fadeIn();$('#hideProduct-<%=order._id%>').fadeIn();$(this).hide();" style="cursor:pointer;text-decoration: underline;text-align: center;">Voir les produits</p>
                <p id="hideProduct-<%=order._id%>" onclick="$('#<%=order._id%>').hide();$('#showProduct-<%=order._id%>').fadeIn();$(this).hide();" style="display:none;cursor:pointer;text-decoration: underline;text-align: center;">Cacher les produits</p>
                <span id="<%=order._id%>" style="display:none;">
                <% order.checkoutCart.items.forEach(function(element){ %>
                    <table  class="table shoping-cart-table" style="height: 160px;">
                        <tbody>
                        <tr>
                            <td width="90">
                                <div class="cart-product-imitation">
                                    <img style="width: 100%;" src="upload/<%=element.images[0]%>"/>
                                </div>
                            </td>
                            <td class="desc">
                                <h3>
                                  <a href='<%=element.sectionUrl%>/<%=element.url%>' class="text-navy">
                                    <%= element.title%>
                                </a>
                                </h3>
                                <p class="small">
                                    <%= element.legend%>
                                </p>
                            </td>
                            <td>
                                <h4>
                                    <%= element.price%> €
                                </h4>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                <%}); %>    
              </span>
            </div>
							<div class="ibox-content">
								<div class="d-flex justify-content-between" style="margin:20px 0;">
									<h3>Total : <%=order.checkoutCart.total%> €</h3>
									<a class="button-link" >Téléchager la facture</a>
								  </div>
								
							</div>
						</div>
					</div>
				<% }); %>
			</div>
		<%} else { %>
			<p>Vous n'avez pas fait de commande pour l'instant</p>
		<% } %>
	</div>
<%} %>
  


	</div> 
</div>

<script type="text/javascript" >
  //--------------------------------------------
  $(document).ready(function() {
     
      function Loading(){
        if(
          $('input[name="firstName"]').val() != "" &&
          $('input[name="lastName"]').val() != "" &&
          $('input[name="email"]').val() != "" &&
          $('textarea[name="content"]').val() != ""
        ){
          $('#buttonText').hide();
          $('#buttonLoading').fadeIn();
        }
      }
});
</script>


<%- include('../partials/footer') %>
