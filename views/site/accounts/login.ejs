<%- include('../partials/header') %>
<%- include('../partials/menu') %>
<%- include('../partials/flash') %>

<%if(general.backgroundImage){%>
	<style media="screen">
		.content {
		background: url('/upload/<%=general.backgroundImage%>') no-repeat center center fixed !important;
		-webkit-background-size: cover !important;
		-moz-background-size: cover !important;
		-o-background-size: cover !important;
		background-size: cover !important;
		/* backdrop-filter: brightness(40%) !important; */
		min-height: 100vh !important;
		color:white  !important;
		/* backdrop-filter: blur(10px) !important; */
		}
		.police-menu{
		color:white !important;
		}
	</style>
  <%}%>

<div class="jumbotron centered">
	<div class="container">
		<h1 class="display-6 text-center"><%= lang.menuLogin %></h1>
		<div class="form-custom-small">
			<div class="login-register">
				<form action="/login" method="POST" autocomplete="off">
					<div class="form-floating">
						<input type="text" name="username" placeholder="<%= lang.email %>" class="form-control">
						<label for="floatingInput"><%= lang.email %></label>
					</div>
					<div class="form-floating">
						<input type="password" name="password" placeholder="<%= lang.password %>" class="form-control">
						<label for="floatingPassword"><%= lang.password %></label>
					</div>
					<div class="d-flex justify-content-center">
						<button type="submit" class="button-link" ><%= lang.menuLogin %></button>
					</div>
					
				</form>
				<p class="mt-2"><%= lang.messageNoAccount %> <a href="/register" class="text-center"><%= lang.menuSignup %></a></p>
			</div>
		</div>
	</div>	
</div>

<%- include("../partials/footer") %>
