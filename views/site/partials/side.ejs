    <!-- Side SHOWCASE-->
    
    <% showcaseElements.forEach(function(element, index){ %>
        <% if(element.images.length > 0){ %>
            <a href="/<%=element.section.url%>/<%=element.url%>">
                <div class="card mb-4 element-box-hover">
                    <div class="card-header">
                        <h3 class="fw-normal"><%=element.title%></h3>
                    </div>
                    <img style="width: 100%;height: 200px;-o-object-fit: cover;object-fit: cover;overflow: hidden;" src="/upload/<%=element.images[0]%>" alt="Card image cap">
                    <!-- <h3 style="color:white;background: black;display: inline;" ><%=element.legend%></h3> -->
                </div>
            </a>
        <% } %>
    <% }); %>
    
