<!-- Comments section-->
<div class="element-details-box">
    <h3>Commentaires</h3>
    <hr>
    <!-- <div class="card bg-light">
        <div class="card-body"> -->
            
            <!-- Comment form-->
            <% if(currentUser){%>
                <form action="/comment/add" method="POST" class="mb-4">
                    <input type="hidden" name="elementId" value="<%= element._id %>" />
                    <textarea class="editor" name="content" placeholder="Leave a comment!"></textarea>
                    <div class="d-flex justify-content-end" style="margin:20px 0;">
                        <button class="button-link" type="submit">Poster le commentaire</button>
                    </div>
                    
                </form>
            <% } else { %>
                <!-- <a> Bonjour</a> -->
                <!-- <br> -->
                <div class="centered" style="margin:50px 0;">
                    <p>Vous devez être connecté pour commenter</p>
                    <a class="btn btn-success btn-sm menu-element-link" href="/login" role="button">Se Connecter</a>
                </div>
                <hr>
            <%}%>
            
            <% element.comments.forEach(function(comment){ %>
                <div class="d-flex" style="margin: 20px 0px;">
                    
                    <div class="flex-shrink-0">
                        <span class="fa-stack fa-2x">
                            <i class="fas fa-circle fa-stack-2x "></i>
                            <i class="fas fa-user fa-stack-1x fa-inverse"></i>
                        </span>
                    </div>
                    <div class="ms-3">
                        <h5 class="fw-bold">
                            <% if(comment.user.pseudo){ %>
                                <%=comment.user.pseudo%>
                            <% } else{ %>
                                Utilisateur anonyme
                            <% } %>
                            
                        </h5>
                        <p id="comment-<%=comment._id%>"></p>
                    </div>                                                       
                </div>
                <script type="text/javascript">                                                          
                var txt = "<%=comment.content%>";
                    // function htmlDecode(input) {
                    //     var doc = new DOMParser().parseFromString(input, "text/html");
                    //     return doc.documentElement.textContent;
                    // }
                    var html = htmlDecode(txt);
                    $("#comment-<%=comment._id%>").html(html);
                </script>
                <hr>
            <% }); %>
            <!-- Comment with nested comments-->
