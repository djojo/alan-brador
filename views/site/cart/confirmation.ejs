<div class="container gsapBox">
    <h1 class="display-3 centered">CONFIRMATION</h1>

<div class="container gsapBox">
    <div class="row">
        <div class="col-md-9">
            <div class="ibox">
                <div class="ibox-title">
                    <h3>Confirmation de votre commande </h3>
                </div>
                <div class="ibox-content">
                    <p>Commande n° <%=order._id%></p>
                    <p>Vous avez reçu un mail de confirmation</p>
                    <p>Merci d'avoir passé commande chez nous, à bientôt !</p>
                </div>
                <div class="ibox-content">
                    <div class="d-flex justify-content-between">
                        <a href="/"><button class="btn btn-white roboto"><i class="fa fa-arrow-left"></i> Retour à l'accueil</button></a>
                        <a href="/checkout"><button class="button-link"> Télécharger</button></a>
                    </div>
                </div>
            </div>
            <div class="ibox">
                <div class="ibox-title">
                    <h3>Récapitulatif </h3>
                </div>
                <div class="ibox-content">
                    <p><%=order.firstName%> <%=order.lastName%></p>
                    <p><%=order.address.address%>, <%=order.address.zipCode%></p>
                    <p><%=order.address.city%>, <%=order.address.country%></p>
                    <p><%=order.address.phone%></p>
                </div>
                <div class="ibox-content">
                    <% order.checkoutCart.items.forEach(function(element){ %>
                        <table class="table shoping-cart-table" style="height: 160px;">
                            <tbody>
                            <tr>
                                <td width="90">
                                    <div class="cart-product-imitation">
                                        <img style="width: 100%;" src="upload/<%=element.images[0]%>"/>
                                    </div>
                                </td>
                                <td class="desc">
                                    <h3>
                                    <a href='<%=element.sectionUrl%>/<%=element.url%>' class="text-navy">
                                        <%= element.title%>
                                    </a>
                                    </h3>
                                    <p class="small">
                                        <%= element.legend%>
                                    </p>
                                </td>
                                <td>
                                    <h4>
                                        <%= element.price%> €
                                    </h4>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                        <hr>
                    <%}); %>    

                    <p>Vous serez livré d'ici 5 jours.</p>
                </div>
                <div class="ibox-content">
                    <h3>Total : <%=order.checkoutCart.total%> €</h3>
                </div>
            </div>

        </div>
        <div class="col-md-3">
            <div class="ibox">
                <div class="ibox-title">
                    <h3>Facture</h3>
                </div>
                <div class="ibox-content">
                    <div class="m-t-sm" style="text-align: center;">
                        <div class="btn-group">
                            <!-- <a href="/"></a><button class="btn btn-white"><i class="fa fa-arrow-left"></i> Annuler</button> -->
                            <a href="/checkout"><button class="button-link"> Télécharger</button></a>
                        </div>
                    </div>
                </div>
                
            </div>

