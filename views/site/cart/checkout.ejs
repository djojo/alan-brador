                                <!-- <a href="/"></a><button class="btn btn-white"><i class="fa fa-arrow-left"></i> Annuler</button> -->
                                <a href="/checkout"><button class="button-link" ><i class="fa fa fa-shopping-cart"></i> Checkout</button></a>
                            </div>
                        </div>
                    </div>
                <% } else { %>		
