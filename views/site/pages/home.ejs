<%- include('../partials/header') %>
<%- include('../partials/menu', {menu: menu, general: general}) %>
<%- include('../partials/flash') %>

<style>
.swiperGallery {
    width: 100%;
    min-height: 400px;
    animation: startSlider 0.8s ease-in-out;
}

@keyframes startSlider {
  0%   {transform: scale(1.3);}
  /* 80%   {transform: scale(0.95);} */
  100% {transform: scale(1);}
}




</style>

<div id="homeContainer" class="container">
  <div class="row gx-4 gx-lg-5 align-items-center">
    <div class="col-md-12" style="text-align: center;">
      <div class="swiperGallery">
        <!-- Additional required wrapper -->
        <div class="swiper-wrapper">
          <% general.showcaseElements.forEach(function(element, index){%>
              <div style="cursor:pointer;" onclick="location.href='<%=element.section.url%>/<%=element.url%>';" class="swiper-slide">
                <img style="margin-bottom: 5px;max-width:100%;max-height:100%;top: 50%;position: relative;transform: translateY(-50%);" src="upload/<%=element.images[0]%>" />
              </div>
          <%});%>
          <% if(general.showcaseElements.length>1){ %>
            <!-- If we need pagination -->
            <!-- <div class="swiper-pagination"></div> -->
      
            <!-- If we need navigation buttons -->
            <!-- <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div> -->
          <%}%>
        </div>     
       
        
      </div>
      
    </div>
  </div>
</div>


<%- include('../partials/footer') %>


<script type="text/javascript">

  // $('.swiperGallery').animate({
  //       transform: 'scale(1)',
  //       }, 5000, function() {
  // });

  const swiper1 = new Swiper(".swiperGallery", {
        spaceBetween: 30,
        effect: "fade",
        speed: 3000,
        loop: true,
        fadeEffect: { crossFade: true },
        autoplay: {
        delay: 5000,
        disableOnInteraction: false,
        }
      });
</script>

<script>
  var txt = "<%= general.homeMessage %>";
  function htmlDecode(input) {
      var doc = new DOMParser().parseFromString(input, "text/html");
      return doc.documentElement.textContent;
  }
  var html = htmlDecode(txt);
  $("#homeMessage").html(html);

  var size = window.innerHeight - 350;
  $(".swiperGallery").css({height: size});

</script>
