	 transform: translateX(-50%) scale(1.4);
	 opacity: 0.4;
	 filter: blur(50px) saturate(3);
}
/*---------------------------------------- Slider 2 ----------------------------------------*/
 .slider-2 {
	 position: absolute;
	 z-index: 11;
	 top: 50%;
	 left: 50%;
	 width: 50%;
