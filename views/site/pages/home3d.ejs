      <script>

        $(".link-site-medium").on("click",function(){
              $("section").scrollTop(0);
        });

        $(window).scroll(function() {
          $("#navScroll").fadeOut();
        });
        function scrollll(id){
          // alert(window.innerWidth);
          if(window.innerWidth < 800 ){
            $('#menuBox').fadeOut();
          }
          if(id == "home"){
            // $("#navScroll").fadeIn();
          } else{
            $("#navScroll").fadeOut();
          }
          $("section").css({'opacity': 0});
          // $("section").animate({
          //   opacity: 0
          // }, 1000);
          $([document.documentElement, document.body]).animate({
            scrollTop: $("#"+id).offset().top,
              // scrollTop: $("#"+id).offset().top -150
            },
            {
              easing: 'swing',
              duration: 800,
              complete: function(){
                // $("#"+id).css({'opacity': 1});
                $("#"+id).animate({
                  opacity: 1
                }, 300);
              }
            });
          

          // <% for(index=0;index<10*menu.length+3;index++){ %>
    
          //     torus<%= index %>.rotation.z += 30;

          // <% }; %>
          // camera.rotation.z = t * 0.2;

          // alert('oui')
            // $(window).scrollTop(1000);
        }

        // Get the container element
        // var btnContainer = document.getElementsByClassName("menuSite");

        // Get all buttons with class="btn" inside the container
        var btns = document.getElementsByClassName("link-site-medium");

        // Loop through the buttons and add the active class to the current/clicked button
        for (var i = 0; i < btns.length; i++) {
          btns[i].addEventListener("click", function() {
            
            var current = document.getElementsByClassName("active");
            // alert(current);
            current[0].className = current[0].className.replace(" active", "");
            this.className += " active";
          });
        }
      </script>
  
