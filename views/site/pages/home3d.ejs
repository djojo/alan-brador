      <div onclick="scrollll('<%=menu[0].url%>');" id="navScroll" style="cursor:pointer;z-index:110;position:fixed;bottom:3rem;width:100%;text-align:center;">
        <img  style="width: 5rem;" src="img/scroll.png" />
