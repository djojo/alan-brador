<%- include('../partials/adminheader') %>
<%- include('../partials/adminmenu') %>
<%- include('../partials/adminflash') %>

  <div class="container">

<div class="form-custom">
  <form action="/admin/sections/create" method="POST" encType="multipart/form-data">
    <h1 class="display-6">Ajouter une section au site</h1>

    <div class="form-floating">
      <input required type="text" class="form-control" placeholder="Nom" name="title">
      <label for="floatingInput">Nom</label>
    </div>

    <!-------------------------- T Y P E   O F    S E C T I O N -------------------->
    <div class="form-group border-box-site">
      <p class="lead">Type de section </p>
      <a id="gallery" onclick="changeSelector(this, 'gallery');" class="link-site select-link">Gallerie</a>
      <a id="shop" onclick="changeSelector(this, 'shop');" class="link-site select-link">Boutique</a>
      <a id="events" onclick="changeSelector(this, 'events');" class="link-site select-link">Evenements</a>
      <a id="articles" onclick="changeSelector(this, 'articles');" class="link-site select-link">Articles</a>
      <p class="lead">Ou type de page </p>
      <a id="page" onclick="changeSelector(this, 'page');" class="link-site select-link">Page</a>
      <a id="about" onclick="changeSelector(this, 'about');" class="link-site select-link">About</a>
      <a id="landing" onclick="changeSelector(this, 'landing');" class="link-site select-link">Landing</a>
      <select style="display:none;" name="type" id="typeSelector">
          <option value="gallery">Gallerie</option>
          <option value="shop">Boutique</option>
          <option value="events">Evenements</option>
          <option value="articles">Articles</option>
          <option value="page">Page</option>
          <option value="about">About</option>
          <option value="landing">Landing</option>
      </select>
    </div>

    <!-------------------------- V I S I B L E -------------------->
    <div class="form-group border-box-site">
      <p class="lead">En ligne</p>
        <input id="checkboxVisible" type="checkbox" name="visible" > 
        <script>
          $("#checkboxVisible").bootstrapSwitch('state', true);
        </script>
    </div>
    
    <!-------------------------- T E X T    E D I T O R -------------------->
    <!-- <div class="form-floating">
      <textarea class="form-control" placeholder="Description" id="summernote" name="description"></textarea>
    </div> -->


    

    <!-- ----------------------- B A C K G R O U N D     I M A G E  --------------------->
    <div class="form-group border-box-site" >
      <p class="lead">Background image </p>
      <img id="displayImg" onclick="$('#input-file').click();" style="max-width:100%;max-height: 100px;" src="/img/no-img.png" alt="no img">
      <a style="margin-left: 30px;" onclick="$('#input-file').click();" class="link-site">Choose file</a>
      <input style="display:none;" id="input-file" onchange="encodeImgtoBase64(this)" name="backgroundImage" accept="image/png, image/gif, image/jpeg" type="file" class="form-control-file">
    </div>
    
    <button class="w-100 link-site" type="submit">Ajouter</button>
  </form>
</div>

</div>

<script type="text/javascript">

  ////////////////////////////      SELECTOR
  function changeSelector(selected, value){
    $(".select-link").css({background:'transparent', color: '#212529'});
    $(selected).css({background:'#212529', color: 'white'});
    $('#typeSelector option[value="'+value+'"]').prop('selected', true);
  }
  //select options auto
  $('#typeSelector option[value="gallery"]').prop('selected', true);
  $('#gallery').css({background:'#212529', color: 'white'});

