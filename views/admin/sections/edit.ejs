<%- include('../partials/adminheader') %>
<%- include('../partials/adminmenu') %>
<%- include('../partials/adminflash') %>


<div class="container">

<main class="form-custom">
  <form action="/admin/sections/edit" method="POST" encType="multipart/form-data">
    <h1 class="display-6">Modifier la section: <%=section.title%></h1>
    <input type="hidden" name="sectionId" value="<%=section._id%>">
    <input type="hidden" name="type" value="<%=section.type%>">
    <input id="actualBackgroundImage" type="hidden" name="actualBackgroundImage" value="<%=section.image%>">
    <input id="deleteBackgroundImage" type="hidden" name="deleteBackgroundImage" value="no">
    <input type="hidden" name="images" value="<%=section.images%>" id="imagesToKeep">
    <input type="hidden" name="imagesToDelete" value="" id="imagesToDelete" >
    <div class="form-floating">
      <input value="<%=section.title%>" type="text" class="form-control" placeholder="Titre" name="title">
      <label for="floatingInput">Titre</label>
    </div>

    <!-------------------------- T Y P E   O F    S E C T I O N -------------------->

    <% if(section.type != "page" && section.type != "about" && section.type != "landing"){ %>
      <!-- <div class="form-group border-box-site">
        <p class="lead">Type de section (pour l'affichage) </p>
        <a id="gallery" onclick="changeSelector(this, 'gallery');" class="link-site select-link">Gallerie</a>
        <a id="shop" onclick="changeSelector(this, 'shop');" class="link-site select-link">Boutique</a>
        <a id="events" onclick="changeSelector(this, 'events');" class="link-site select-link">Evenements</a>
        <a id="articles" onclick="changeSelector(this, 'articles');" class="link-site select-link">Articles</a>
        <select style="display:none;" name="type" id="typeSelector">
            <option value="gallery">Gallerie</option>
            <option value="shop">Boutique</option>
            <option value="events">Evenements</option>
            <option value="articles">Articles</option>
        </select>
      </div> -->
    <%} else {%>
      <!-- <div class="form-group border-box-site">
        <%= section.type %>
        <p class="lead">Type de page </p>
        <a id="page" onclick="changeSelector(this, 'page');" class="link-site select-link">Page</a>
        <a id="about" onclick="changeSelector(this, 'about');" class="link-site select-link">About</a>
        <a id="landing" onclick="changeSelector(this, 'landing');" class="link-site select-link">Landing</a>
        <select style="display:none;" name="type" id="typeSelector">
          <option value="page">Page</option>
          <option value="about">About</option>
          <option value="landing">Landing</option>
      </select>
        
      </div> -->
    <%}%>

    <!-- <select style="display:none;" name="type" id="typeSelector">
        <option value="page">Page</option>
        <option value="about">About</option>
        <option value="landing">Landing</option>
    </select> -->

    <!-------------------------- V I S I B L E -------------------->
    <div class="form-group border-box-site">
      <p class="lead">En ligne</p>
      <input id="checkboxVisible" type="checkbox" name="visible">
      <%if(section.visible === true){%>
        <script>
          $("#checkboxVisible").bootstrapSwitch('state', true);
        </script>
      <%}else{%>
        <script>
          $("#checkboxVisible").bootstrapSwitch('state', false);
        </script>
      <%}%>
    </div>

    <!-- ------------- IF S E C T I O N    =    L A N D I N G   ------------------->
    <% if(section.type === "landing") { %>
      <!--------------------------  R E V E A L   D A T E -------------------->
      <div class="form-floating">
        <input id="datePicker" type="date" class="form-control" name="revealDate">
        <label for="floatingInput">Date et heure de revelation</label>
      </div>
      <script>
        $('#datePicker').val(new Date('<%= section.revealDate%>').toLocaleDateString('fr-CA'));
      </script>
      <!-------------------------- R E V E A L   D A T A -------------------->
      <div class="form-floating">
        <input value="<%=section.revealData%>" type="text" class="form-control" placeholder="Data" name="revealData">
        <label for="floatingInput">Data à révéler</label>
      </div>
    <%} %>  
    
    <!-------------------------- T E X T    E D I T O R -------------------->
    <% if(section.type === "page" || section.type === "about" || section.type === "landing") { %>
      <div class="form-floating">
        <textarea class="form-control" placeholder="Description" id="summernote" name="description"><%=section.description%></textarea>
      </div>
    <%} %>  
    

    <!-- ----------------------- B A C K G R O U N D     I M A G E  --------------------->
    <div class="form-group border-box-site" >
      <p class="lead">Background image &nbsp;
        <input id="checkboxBackground" type="checkbox" name="backgroundImage">
        <%if(section.image){%>
          <script>
            $("#checkboxBackground").bootstrapSwitch('state', true);
          </script>
        <%}else{%>
          <script>
            $("#checkboxBackground").bootstrapSwitch('state', false);
          </script>
        <%}%>
        <script>
          $('#checkboxBackground').on('switchChange.bootstrapSwitch', function (event, state) {
              if(state == true){
                $("#backgroundImage").fadeIn(300);
                $("#deleteBackgroundImage").val("no");
              }
              else{
                $("#backgroundImage").fadeOut(300);
                $("#deleteBackgroundImage").val("yes");
                // $("#backgroundImageInput").val(false);
              }
            });
        </script>
     </p>

     <!-- <input id="backgroundImageInput" type="hidden" value="" name="backgroundImage" /> -->

      <script>
        $('#input-file').change(function() {
          alert( "Handler for .change() called.");
          $("#backgroundImageInput").val(true);
        });
      </script>
      
      
      <!-- ----------------------- B A C K G R O U N D      I M A G E --------------------->
      <span id="backgroundImage">
        <% if(section.image){ %>
            <img id="displayImg" onclick="$('#input-file').click();" style="max-width:100%;max-height: 100px;" src="upload/<%=section.image%>" alt="<%=section.title%>">
        <%} else {%>
            <img id="displayImg" onclick="$('#input-file').click();" style="max-width:100%;max-height: 100px;" src="img/<%= lang.noImg %>" alt="no img">
            <script>$("#backgroundImage").fadeOut(300);</script>
        <%}%>
        <a style="margin-left: 30px;" onclick="$('#input-file').click();" class="link-site">Choose image</a>
        <input style="display:none;" id="input-file" onchange="encodeImgtoBase64(this)" name="backgroundImage" accept="image/png, image/gif, image/jpeg" type="file" class="form-control-file">
      </span>
      
    </div>


    <!-- ----------------------- IF SECTION == PAGE --------------------->
    <% if(section.type == "page" || section.type === "about"  || section.type === "landing"){ %>


      

      <!-- ----------------------- I M A G E S --------------------->
      <div class="form-group border-box-site">
        <div class="d-flex justify-content-between">
          <p class="lead">IMAGES</p>
          <p><a href="https://www.iloveimg.com/" target="_blank">Please optimise your files before upload</a></p>
          <button onclick="$('#input-multi-files').click();" class="link-site-small" type="button"><i class="fa fa-plus fa-lg"></i></button>
          <input style="display:none;" id="input-multi-files" name="sampleFile" accept="image/*" multiple type="file" class="form-control-file">
        </div>
        
        <hr>

        <div class="row preview-images">
          <%  section.images.forEach(function(image, order){ %>
            <div onclick="DeleteImage('<%=image%>', '<%=order%>')" class="col-xs-12 col-sm-12 col-md-6 col-lg-4" id="<%=order%>">
                <figure class="img-container">
                    <img class="img-gallery" src="/upload/<%=image%>" />
                </figure>
            </div>
          <%  }) %>
        </div>
      </div>

      <!-- ---------------    Y O U T U B E    --------------------- -->

      <div class="form-group border-box-site">
        <div class="d-flex justify-content-between">
          <div>
            <p class="lead">LIENS YOUTUBE </p>
          </div>
          <div>
            <input id="inputYoutubeLink" type="text" class="form-control" placeholder="ex: 2hSt_Wa0vIU">
          </div>
          <div>
            <button onclick="addInputYoutube();" class="link-site-small" type="button"><i class="fa fa-plus fa-lg"></i></button>
          </div>
        </div>
        
        <hr>
        <div class="row youtubeSection">
          <%if((section.youtube)){%>
              <%for(i = 0; i<section.youtube.length; i++){ %>
                <div class="col-xs-6 col-sm-4 col-md-3" id="<%=section.youtube[i]%>">
                  <div  class="boxYoutubeElement">
                    <i style="cursor: pointer; color: white; position: absolute; z-index: 22; left: 10px;" onclick="removeYoutubeLink('<%=section.youtube[i]%>');" class="fa fa-times fa-2x" aria-hidden="true"></i>
                    <div class="blurYoutube"></div>
                    <iframe style="position: absolute;" width="180" height="120" src="https://www.youtube.com/embed/<%=section.youtube[i]%>?controls=0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                  </div>
                </div>
              <%}%>
            <%}%>
        </div>
        <!-- le input caché -->
        <div class="form-floating" style="display:none;" >
          <input value="<%=section.youtube%>" type="text" class="form-control" id="YoutubeFinalInput" placeholder="" name="youtube">
        </div>
      </div>

      <!--------------------------- L I N K        S O C I A L --------------------------->
      <div class="form-group border-box-site">
        <p class="lead">LIENS WEB :</p>
        <hr>
        <div class="row" style="margin-bottom:30px;">
          <div class="col-2">
            <input id="linkName" placeholder="Nom" type="text" class="form-control" />
          </div>
          <div class="col-8">
            <input id="linkValue" placeholder="Lien" type="text" class="form-control" />
          </div>
          <div class="col-1">
            <a class="link-site" onclick="addLink();">Ajouter </a>
          </div>
        </div>
        
        <script>
          var socialLinkTable = [];
          let link;
        </script>
        <div id="links">
          <%if((section.webLinks)){%>
            <% section.webLinks.forEach(function(element){ %>
              <span id="<%= element._id %>">
                <hr>
                <div class="row" >
                  <div class="col-2">
                    <p class="lead"><%= element.name %></p>
                  </div>
                  <div class="col-8">
                    <p class="lead"><%= element.adress %></p>
                  </div>
                  <div class="col-1">
                    <a class="link-site" onclick="deleteLink('<%= element._id %>', '<%= element.name %>');">Supprimer</a>
                  </div>
                </div>
                <script>
                  link = {
                      name: '<%= element.name %>',
                      adress: '<%= element.adress %>'
                  }
                  socialLinkTable.push(link);
                </script>
              </span>
            <%});%>
          <% } %>
        </div>
      
        <input id="socialLinks" type="hidden" name="socialLinks" />
      </div>
    <% } %>
    
    
    <button class="w-100 link-site" type="submit">Modifier</button>
  </form>
  <a href="admin/sections/<%=section.title%>"><button class="w-100 link-site">Annuler</button></a>
</main>

</div>

<!-- <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script> -->
<script type="text/javascript">

  ////////////////////////////      SELECTOR
  function changeSelector(selected, value){
    $(".select-link").css({background:'transparent', color: '#212529'});
    $(selected).css({background:'#212529', color: 'white'});
    $('#typeSelector option[value="'+value+'"]').prop('selected', true);
  }
  //select options auto
  $('#typeSelector option[value="<%=section.type%>"]').prop('selected', true);
  $('#<%=section.type%>').css({background:'#212529', color: 'white'});



  ////////////////////////////      EDITOR
  $(document).ready(function() {
        $('#summernote').summernote({
          placeholder: 'Description...',
          tabsize: 2,
          height: 150,
          callbacks: {
              onPaste: function (e) {
                  var bufferText = ((e.originalEvent || e).clipboardData || window.clipboardData).getData('Text');
                  e.preventDefault();
                  document.execCommand('insertText', false, bufferText);
              }
          },
          toolbar: [
              ['style', ['bold', 'italic', 'underline']]
              // ['color', ['color']],
              // ['para', ['ul', 'ol', 'paragraph']],
              // ['view', ['codeview']],
          ],
          focus: false 
        });
  });

  //TextEncoder BASE 64
  function encodeImgtoBase64(element) {
      var img = element.files[0];
      var reader = new FileReader();
      reader.onloadend = function() {
      $("#displayImg").attr("src", reader.result);
    }
    reader.readAsDataURL(img);
  }

</script>

<!-- ----------------------- IF SECTION == PAGE ----------------------->
<% if(section.type == "page" || section.type === "about" || section.type === "landing"){ %>
<script type="text/javascript">


  ////////////////////////////      IMAGES
  $(document).ready(function() {  
    let imagesPreview = function(input, placeToInsertImagePreview) {
      if (input.files) {
        let filesAmount = input.files.length;
        for (i = 0; i < filesAmount; i++) {
          let reader = new FileReader();
          reader.onload = function(event) {
            var html = "";
            html += "<div onclick='$(this).remove();' class='col-xs-12 col-sm-12 col-md-6 col-lg-4'>";
            html += "<figure class='img-container'>";
            html += "<img class='img-gallery' src='"+event.target.result+"' />";
            html += "</figure>";
            html += "</div>";
            $(".preview-images").append(html);  

            // $($.parseHTML("<img>"))
            //   .attr("src", event.target.result)
            //   .appendTo(placeToInsertImagePreview);
          };
          reader.readAsDataURL(input.files[i]);
        }
      }
    };
    $("#input-multi-files").on("change", function() {
      imagesPreview(this, "div.preview-images");
    });
  });

  // On créer un tableau des images a delete
  var TableDeleteImage = [];
  //on créer le tableau des images à garder
  var TableImages = [];
  <%if(section.images){%>
    <%for(i = 0; i<section.images.length; i++){ %>
        TableImages.push("<%=section.images[i]%>");
    <%}%>
  <%}%>
  function DeleteImage(id,position){
    // alert(id);
    TableDeleteImage.push(id);
    //on update le input hidden
    $("#imagesToDelete").val(TableDeleteImage.toString());
    
    //On supprime de la page
    $("#"+position).remove();
    //On supprime du tableau des images a garder
    TableImages = jQuery.grep(TableImages, function(value) {
      return value != id;
    });
    //On update le input hidden
    $("#imagesToKeep").val(TableImages.toString());
  }


  //--------------YOUTUBE -----------
  // On créer le tableau deja present
  var TableYoutube = [];
  <%if(section.youtube){%>
    <%for(i = 0; i<section.youtube.length; i++){ %>
        TableYoutube.push("<%=section.youtube[i]%>");
    <%}%>
  <% } %>

  function removeYoutubeLink(id){
    //On supprime de la page
    $("#"+id).remove();
    //On supprime du tableau
    TableYoutube = jQuery.grep(TableYoutube, function(value) {
      return value != id;
    });
    //On update le input hidden
    $("#YoutubeFinalInput").val(TableYoutube.toString());
  }
  // alert(TableYoutube);
  function addInputYoutube(){
    //on ajoute au tableau youtube
    var inputYoutubeLink = $("#inputYoutubeLink").val();

    if(inputYoutubeLink != ""){
      TableYoutube.push(inputYoutubeLink);
      //On update le input hidden
      $("#YoutubeFinalInput").val(TableYoutube.toString());

      //On ajoute la video sur la page
      var html = "";
      html += "<div class='col-xs-6 col-sm-4 col-md-3' id='" + inputYoutubeLink + "'>";
      html += "<div class='boxYoutubeElement'>";
      html += "<i style='cursor: pointer; color: white; position: absolute; z-index: 22; left: 10px;' onclick='removeYoutubeLink(`" + inputYoutubeLink + "`);' class='fa fa-times fa-2x' aria-hidden='true'></i>";
      html += "<div class='blurYoutube'></div>";
      html += "<iframe style='position: absolute;' width='180' height='120' src='https://www.youtube.com/embed/"+inputYoutubeLink+"?controls=0' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture' allowfullscreen></iframe>";
      html += "</div>";
      html += "</div>";
      $(".youtubeSection").append(html);
    }

    //On remet le input a 0
    $("#inputYoutubeLink").val("");
  }

</script>

<!-- LINK SOCIALS -->
<script type="text/javascript">

  //On init le input hidden
  $("#socialLinks").val(JSON.stringify(socialLinkTable));

  
  var id = 0;
  function addLink(){
    // let newLinkObject =  [];
    let linkName = $("#linkName").val();
    let linkValue = $("#linkValue").val();
    if(linkName != "" && linkValue != ""){
      let obj = {
          name: linkName,
          adress: linkValue
      };
      socialLinkTable.push(obj);

      //on reset le formulaire
      $("#linkName").val("");
      $("#linkValue").val("");
       
      //On update le input hidden
      $("#socialLinks").val(JSON.stringify(socialLinkTable));

      //on rajoute sur la page

      var html = '<span id="'+id+'"><hr>';
      html += '<div class="row">';
      html +='<div class="col-2" >';
      html += '<p class="lead">'+linkName+'</p>';
      html += '</div>';
      html += '<div class="col-8">';
      html += '<p class="lead">'+linkValue+'</p>';
      html += '</div>';
      html += '<div class="col-1">';
      html += "<a class='link-site' onclick='deleteLink(`"+id+"`, `"+linkName+"`);'>Supprimer</a>";
      html += '</div>';
      html += '</div></span>';
      $("#links").append(html);
      id++;
    }
    else{
      alert("Vous devez remplir les champs !");
    }
    
  }

  function deleteLink(id, name){
    $('#'+id).remove();
    //on supprime du tableau
    socialLinkTable.forEach(function(element, index){
      if(element.name == name){
        var filtered = socialLinkTable.filter(function(el) { return el.name != name; });
        //On update le input hidden
        $("#socialLinks").val(JSON.stringify(filtered));
      }
    });
  }
</script>

<%}%>

<%- include('../partials/adminfooter') %>
