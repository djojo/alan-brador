<script type="text/javascript">
  $(document).ready(function(){
    $("#searchElement").on("keyup", function() {
      var value = $(this).val().toLowerCase();
      $("#sortable li").filter(function() {
        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
      });
    });
  });
</script>


<!--------------------------- T O G G L E    G R I D / L I S T --------------------------------->
<script type="text/javascript">
  // Get the elements with class="column"
var elements = document.getElementsByClassName("column");

// Declare a loop variable
var i;
var j;

// List View
function listView() {
  for (i = 0; i < elements.length; i++) {
    elements[i].style.width = "100%";
  }
  
  $(".element-box").css({height : "60px"});
  $(".element-image-container").css({width : "60px", height : "60px", display : "inline-block"});
  $(".element-img").css({height : "60px"});
  $(".element-info").css({height : "20px", display : "inline-block", bottom: "22px", left: "20px", position: "relative"});
  $(".line-show").css({display: "inline-block"});
}

// Grid View
function gridView() {
  for (i = 0; i < elements.length; i++) {
    elements[i].style.width = "";
  }
  $(".element-box").css({height : ""});
  $(".element-img").css({height : "150px"});
  $(".element-image-container").css({width : "", height : "", display : ""});
  $(".element-info").css({height : "", display : "", bottom: "", left: "", position: ""});
  $(".line-show").css({display: "none"});
}
</script>


<script type="text/javascript">
  
  $( document ).ready(function() {


    // ------------- M O D A L    D E L E T E ---------------
    var ebModal = document.getElementById('modal');
    var ebSpan = document.getElementsByClassName("modalClose")[0];
    ebSpan.onclick = function() {
        ebModal.style.display = "none";
    }
    window.onclick = function(event) {
        if (event.target == ebModal) {
            ebModal.style.display = "none";
        }
    }

    // ------------- T E X T    F O R M A T ---------------
    var txt = "<%=section.description%>"
    function htmlDecode(input) {
      var doc = new DOMParser().parseFromString(input, "text/html");
      return doc.documentElement.textContent;
    }
    var html = htmlDecode(txt);
    $("#descriptionText").html(html);

    // -------------A J A X    V I S I B L E ---------------
    $('#checkboxVisible').on('switchChange.bootstrapSwitch', function (event, state) {
      $.ajax({
            url: "/admin/sections/visible",
            type: "POST",
            data: {
                '_id': '<%=section._id%>',
                'state': state
            },
            success: function(data){
                alert(data.state);
            }
        });
    }); 

  }); 
</script>
