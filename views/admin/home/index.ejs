<%- include('../partials/adminheader') %>
<%- include('../partials/adminmenu') %>
<%- include('../partials/adminflash') %>

<div class="jumbotron">
  <div class="container">
    <!-- <i class="fas fa-id-card fa-6x"></i> -->
    <div class="col-lg-12">
      <div class="d-flex justify-content-between">
        <h1 style="display: inline;" class="display-3">
          <span>HOME </span>
        </h1>
        <p style="margin: 1rem 0;">
          <input style="width:200px;display:inline-block;" class="form-control" id="searchElement" type="text" placeholder="Rechercher..">  
          <a title="Rechercher dans les éléments" class="link-site-small" ><i class="fa fa-search fa-lg"></i></a>
        </p>
      </div>
      
    </div>
    <div class="col-lg-12">
      <hr>
      <p class="lead">Cliquez sur les éléments à mettre en avant ici !</p>
    </div>
    
    
    <div class="row" id="myTable" style="margin-top: 3rem;">
      <%  elements.forEach(function(element){ %>
        <a onclick="toggleShowcaseElement('<%=element._id%>');" class="col-xs-12 col-sm-6 col-md-3 col-lg-3">
          <% if( general.showcaseElements.indexOf(element._id.toString()) == -1 ){ %>
            <div id="showcase-<%=element._id%>" class="link-site">
              <img style="display:inline-block;width:30px;height:30px;object-fit: cover;" src="upload/<%=element.images[0]%>" />
              <%= element.title %>
            </div> 
          <% } else { %>
            <div id="showcase-<%=element._id%>" style="background:black; color:white;" class="link-site">
              <img style="display:inline-block;width:30px;height:30px;object-fit: cover;" src="upload/<%=element.images[0]%>" />
              <%= element.title %>
            </div>
          <% } %>
        </a>
      <%  }) %>
    </div>
    
    <!-- <p class="lead"><%= general.homeMessage %></p> -->

    <!-- <p class="lead">Vous pouvez modifier la page d'accueil ici !</p>
    <hr> -->
    <form class="form-custom" action="/admin/home" method="POST" encType="multipart/form-data">
      <div class="form-group">
        <p class="lead">Message d'accueil:</p>
        <textarea id="summernote-home" name="homeMessage" ><%= general.homeMessage %></textarea>
      </div>
      
      <button type="submit" class="w-100 link-site">Enregistrer</button>
    </form>

  </div>
</div>

<%- include('../partials/adminfooter') %>

<script type="text/javascript">
  $(document).ready(function() {
        $('#summernote-home').summernote({
          placeholder: 'Je suis née en Australie dans les années 90...',
          tabsize: 2,
          height: 200,
          callbacks: {
              onPaste: function (e) {
                  var bufferText = ((e.originalEvent || e).clipboardData || window.clipboardData).getData('Text');
                  e.preventDefault();
                  document.execCommand('insertText', false, bufferText);
              }
          },
          toolbar: [
              ['style', ['bold', 'italic', 'underline']]
              // ['color', ['color']],
              // ['para', ['ul', 'ol', 'paragraph']],
              // ['view', ['codeview']],
          ],
          focus: false 
        });
  });
</script>


<script type="text/javascript">
  $(document).ready(function(){
    $("#searchElement").on("keyup", function() {
      var value = $(this).val().toLowerCase();
      $("#myTable a").filter(function() {
        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
      });
    });
  });
</script>



<script type="text/javascript">
  
  // $( document ).ready(function() {
    function toggleShowcaseElement(id){
      $.ajax({
            url: "/admin/showcase",
            type: "POST",
            data: {
                '_id': id
            },
            success: function(data){
                // alert(data._id);
                if(data.show == true){
                  $("#showcase-"+id).css("background", "black");
                  $("#showcase-"+id).css("color", "white");
                }
                else{
                  $("#showcase-"+id).css("background", "transparent");
                  $("#showcase-"+id).css("color", "black");
                }
                

            }
        });
    }
  // });
    
</script>
